 "client_script": "function formatDate(date) {\n    var d = new Date(date),\n        month = '' + (d.getMonth() + 1),\n        day = '' + d.getDate(),\n        year = d.getFullYear();\n\n    if (month.length < 2) \n        month = '0' + month;\n    if (day.length < 2) \n        day = '0' + day;\n\n    return [year, month, day].join('-');\n}\nfrappe.web_form.after_load = () => {\n    frappe.call({\n        method: \"frappe.client.get\",\n        args: {\n            doctype: 'Employee',\n             filters: {\n                \"user_id\": frappe.session.user\n            }\n        },\n         callback: function(response) {\n            if(response.message) {\n                var Employee = response.message;\n                frappe.web_form.set_value('employee', Employee.employee);\n                frappe.web_form.set_value('employee_name', Employee.employee_name);\n                frappe.web_form.set_value('leave_approver', Employee.leave_approver);\n                frappe.web_form.set_value('leave_status', \"Open\");\n                frappe.web_form.set_value('leave_type', \"Blocked Time Off\");\n                frappe.web_form.set_df_property(\"employee\",\"read_only\",1);\n                frappe.web_form.set_df_property(\"employee_name\",\"read_only\",1);\n                frappe.web_form.set_df_property(\"leave_approver\",\"read_only\",1);\n                //frappe.web_form.set_df_property(\"leave_status\",\"read_only\",1);\n                const date_from = new Date();\n                const InTwoWeeks = date_from.getDate() + 14;\n                date_from.setDate(InTwoWeeks);\n                frappe.web_form.set_value('from_date',formatDate(date_from));\n                const date_to = new Date();\n                const InTwoWeeksPlusOne = date_to.getDate() + 15;\n                date_to.setDate(InTwoWeeksPlusOne);\n                frappe.web_form.set_value('to_date',formatDate(date_to));\n            }\n        }\n    });\n}",
